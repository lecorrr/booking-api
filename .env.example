# Local settings. Create your .env from this file with:  python3 scripts/make_env.py
# Commands run on your machine (manage.py, pytest) use these URLs to reach the Compose
# services; inside Compose the hosts are replaced by service names (see compose.yaml).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_COOKIES=false

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://bookingapi:change-me@127.0.0.1:5436/bookingapi
REDIS_URL=redis://127.0.0.1:6381/0
CACHE_URL=rediscache://127.0.0.1:6381/1

# Reminders are printed by the worker. To send real email set
# MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend and SMTP_HOST, SMTP_USER,
# SMTP_PASSWORD.
DEFAULT_FROM_EMAIL=bookings@example.com

WEB_CONCURRENCY=2
LOG_LEVEL=INFO
